# Optional -- only set these if you have a legitimate OANDA account (API key
# alone is enough, account ID isn't needed for market data). Leave both blank
# to use yfinance only, which is the default and requires no credentials.
OANDA_API_KEY=
OANDA_ENVIRONMENT=practice

# Optional -- per-instrument HalfTrend strategy parameters. Each defaults to
# the Pine script's declared defaults (amplitude=20, channelDeviation=2.0,
# baseRiskMult=3.0 -- CLAUDE.md section 3) if left unset. Override per
# instrument to retune without any code change.
EURUSD_AMPLITUDE=20
EURUSD_CHANNEL_DEVIATION=2.0
EURUSD_BASE_RISK_MULT=3.0
XAUUSD_AMPLITUDE=20
XAUUSD_CHANNEL_DEVIATION=2.0
XAUUSD_BASE_RISK_MULT=3.0

GMAIL_SENDER=
GMAIL_APP_PASSWORD=
ALERT_RECIPIENT_EMAIL=
ACCOUNT_SIZES=6000,10000,25000
RISK_PERCENTAGES=0.5,0.75,1
