# Optional -- only set these if you have a legitimate OANDA account (API key
# alone is enough, account ID isn't needed for market data). Leave both blank
# to use yfinance only, which is the default and requires no credentials.
OANDA_API_KEY=
OANDA_ENVIRONMENT=practice

# Optional -- per-instrument HalfTrend strategy parameters. Each defaults to
# the Pine script's declared defaults (amplitude=20, channelDeviation=2.0,
# baseRiskMult=3.0 -- CLAUDE.md section 3) if left unset. Override per
# instrument to retune without any code change.
EURUSD_AMPLITUDE=20
EURUSD_CHANNEL_DEVIATION=2.0
EURUSD_BASE_RISK_MULT=3.0
XAUUSD_AMPLITUDE=20
XAUUSD_CHANNEL_DEVIATION=2.0
XAUUSD_BASE_RISK_MULT=3.0

# Optional -- trading session window and which days count as trading days.
# Defaults to 06:00-21:30 IST, Monday-Friday (weekday numbers, Monday=0).
# Widen the hours or add Sat/Sun (e.g. "0,1,2,3,4,5,6") with zero code
# changes. Note: a workflow's cron schedule is just a coarse over-covering
# window, not the real gate (session.py is) -- if a new window falls
# outside what a workflow's cron already covers, that cron also needs a
# manual edit (CLAUDE.md section 8).
SESSION_START=06:00
SESSION_END=21:30
TRADING_DAYS=0,1,2,3,4

GMAIL_SENDER=
GMAIL_APP_PASSWORD=
ALERT_RECIPIENT_EMAIL=
ACCOUNT_SIZES=6000,10000,25000
RISK_PERCENTAGES=0.5,0.75,1

# ===========================================================================
# Asia Sweep Reversals system (CLAUDE.md section 14) -- the ACTIVE alert
# system going forward. Runs XAUUSD / EURUSD / GBPUSD / AUDUSD on 1-minute
# candles, Telegram-only (no email), with its OWN Telegram bot. The
# HalfTrend config above is kept only for the retained-but-dormant
# HalfTrend code (GMAIL_* / ALERT_RECIPIENT_EMAIL are unused by Asia Sweep).
# ===========================================================================

# Its own Telegram bot (separate from TELEGRAM_BOT_TOKEN above). Create via
# @BotFather. ASIA_SWEEP_TELEGRAM_CHAT_IDS is comma-separated (a group id is
# negative, e.g. -1003768821764). Either unset/empty = alerts are NOT sent
# (the run logs loudly and continues, it never crashes).
ASIA_SWEEP_TELEGRAM_BOT_TOKEN=
ASIA_SWEEP_TELEGRAM_CHAT_IDS=

# Alert-active window, evaluated in ASIA_SWEEP_WINDOW_TZ (default New York,
# so it holds across US daylight saving). Default NY 04:00-12:00, Mon-Fri.
ASIA_SWEEP_WINDOW_START=04:00
ASIA_SWEEP_WINDOW_END=12:00
ASIA_SWEEP_WINDOW_TZ=America/New_York
ASIA_SWEEP_TRADING_DAYS=0,1,2,3,4

# Strategy params (ported from reference/asia_sweep_source.pine). Global, or
# per-symbol with a {SYMBOL}_ prefix (e.g. XAUUSD_ASIA_SWEEP_MAX_BARS_AFTER_SWEEP).
ASIA_SWEEP_SESSION=1900-0400
ASIA_SWEEP_TIMEZONE=America/New_York
ASIA_SWEEP_INTERNAL_LENGTH=2
ASIA_SWEEP_BREAK_MODE=Close
ASIA_SWEEP_MAX_BARS_AFTER_SWEEP=10
ASIA_SWEEP_STOP_BUFFER_TICKS=0
# Pine's own default is true, but a 200-EMA trend filter on 1m suppresses
# this counter-trend setup almost entirely -- this deployment defaults it
# OFF to match the user's chart. Set true to restore the Pine default.
ASIA_SWEEP_TREND_FILTER=false
ASIA_SWEEP_TREND_EMA_LENGTH=200
# The alert reports a 3-target ladder (T1/T2/T3 = entry +/- {1,2,3} x risk),
# like the HalfTrend emails -- this overrides the Pine's single 2R target.
ASIA_SWEEP_TARGET_MULTIPLES=1,2,3
ASIA_SWEEP_REWARD_RR=2.0

# Warm-up lookback: 1m candles fetched per run. ~2500 covers EMA(200), the
# last completed Asia session + follow-through, and internal-structure state.
ASIA_SWEEP_LOOKBACK_BARS=2500
# The journal fetches more history so the day's trades have room to resolve.
ASIA_SWEEP_JOURNAL_LOOKBACK_BARS=5000

# Optional -- best-effort Telegram nudge alongside each signal email, via
# the official Telegram Bot API (src/telegram_alert.py). Create a bot via
# @BotFather to get TELEGRAM_BOT_TOKEN; TELEGRAM_CHAT_IDS is a
# comma-separated list of chat ids to send to (individuals and/or a
# group -- see README for how to get them). Leave either blank to
# disable; a Telegram send failure never blocks the email.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
