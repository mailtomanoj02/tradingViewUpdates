# Optional -- only set these if you have a legitimate OANDA account (API key
# alone is enough, account ID isn't needed for market data). Leave both blank
# to use yfinance only, which is the default and requires no credentials.
OANDA_API_KEY=
OANDA_ENVIRONMENT=practice

# Optional -- per-instrument HalfTrend strategy parameters. Each defaults to
# the Pine script's declared defaults (amplitude=20, channelDeviation=2.0,
# baseRiskMult=3.0 -- CLAUDE.md section 3) if left unset. Override per
# instrument to retune without any code change.
EURUSD_AMPLITUDE=20
EURUSD_CHANNEL_DEVIATION=2.0
EURUSD_BASE_RISK_MULT=3.0
XAUUSD_AMPLITUDE=20
XAUUSD_CHANNEL_DEVIATION=2.0
XAUUSD_BASE_RISK_MULT=3.0

# Optional -- trading session window and which days count as trading days.
# Defaults to 06:00-21:30 IST, Monday-Friday (weekday numbers, Monday=0).
# Widen the hours or add Sat/Sun (e.g. "0,1,2,3,4,5,6") with zero code
# changes. Note: a workflow's cron schedule is just a coarse over-covering
# window, not the real gate (session.py is) -- if a new window falls
# outside what a workflow's cron already covers, that cron also needs a
# manual edit (CLAUDE.md section 8).
SESSION_START=06:00
SESSION_END=21:30
TRADING_DAYS=0,1,2,3,4

GMAIL_SENDER=
GMAIL_APP_PASSWORD=
ALERT_RECIPIENT_EMAIL=
ACCOUNT_SIZES=6000,10000,25000
RISK_PERCENTAGES=0.5,0.75,1

# Optional -- best-effort Telegram nudge alongside each signal email, via
# the official Telegram Bot API (src/telegram_alert.py). Create a bot via
# @BotFather to get TELEGRAM_BOT_TOKEN; TELEGRAM_CHAT_IDS is a
# comma-separated list of chat ids to send to (individuals and/or a
# group -- see README for how to get them). Leave either blank to
# disable; a Telegram send failure never blocks the email.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
